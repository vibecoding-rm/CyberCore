APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
POLICY_FILE=config/policy.yaml
DATABASE_URL=postgresql://cybercore:change_me@127.0.0.1:5432/cybercore
DATABASE_CONNECT_TIMEOUT_SECONDS=3
BUDGET_REQUEST_WINDOW_SECONDS=3600
BUDGET_LEASE_GRACE_SECONDS=30
BUDGET_KEY=global
API_CREDENTIALS_JSON=[]
APPROVAL_MAX_TTL_SECONDS=3600
LLM_PROVIDER=llamacpp
LLAMACPP_BASE_URL=http://localhost:8081
LLAMACPP_REQUEST_TIMEOUT_SECONDS=180
LLAMACPP_API_KEY=
LLAMACPP_MODEL_FILE=Qwen3.5-9B-Q4_K_M.gguf
LLAMACPP_CONTEXT_TOKENS=8192
# Sólo si LLM_PROVIDER=ollama (instalación nativa de Ollama).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_CONTEXT_TOKENS=8192
ORCHESTRATOR_MODEL=qwen3.5:9b
ANALYST_MODEL=foundation-sec-8b-reasoning
NVD_API_KEY=
NUCLEI_TEMPLATES_DIR=~/nuclei-templates
NUCLEI_ALLOWLIST_FILE=config/nuclei_templates.yaml
# Wazuh server API (sólo lectura). Usa un usuario con rol de lectura y, si el
# certificado es autofirmado, apunta WAZUH_CA_BUNDLE a su CA en vez de desactivar TLS.
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_VERIFY_TLS=true
WAZUH_CA_BUNDLE=
# Greenbone/gvmd (GMP). Usa GREENBONE_SOCKET_PATH (socket Unix) o
# GREENBONE_HOST/PORT con TLS y GREENBONE_CAFILE.
GREENBONE_USER=
GREENBONE_PASSWORD=
GREENBONE_SOCKET_PATH=
GREENBONE_HOST=
GREENBONE_PORT=9390
GREENBONE_CAFILE=
# DefectDojo (exportación de hallazgos probable/confirmed). Token de un usuario
# con permiso de importación; nunca se registra.
DEFECTDOJO_URL=
DEFECTDOJO_API_TOKEN=
DEFECTDOJO_PRODUCT_TYPE=CyberCore
DEFECTDOJO_PRODUCT=CyberCore Lab
DEFECTDOJO_ENGAGEMENT=CyberCore automated
DEFECTDOJO_VERIFY_TLS=true
DEFECTDOJO_CA_BUNDLE=
TOOL_MODE=mock
LOG_LEVEL=INFO
